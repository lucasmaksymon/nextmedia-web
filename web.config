<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <!--
      El .htaccess del repo tiene el redirect sin-www -> www, pero este sitio
      corre en IIS (Microsoft-IIS/10.0), que ignora .htaccess por completo.
      Esta regla es la que realmente aplica en producción: unifica HTTP/HTTPS
      y www/sin-www en una sola URL canónica (https://www.nextmedia.com.ar),
      igual que ya declaran el <link rel="canonical"> y los hreflang del sitio.
      Requiere el módulo URL Rewrite de IIS (estándar en hosting compartido Windows).
    -->
    <rewrite>
      <rules>
        <rule name="Canonicalize to https www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^nextmedia\.com\.ar$" />
          </conditions>
          <action type="Redirect" url="https://www.nextmedia.com.ar/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
